// ===========================================================================
// Внешняя обработка: Выгрузка файлов 1С:ДО с метаданными и версиями
// Совместимость: 1С:Документооборот 2.1 / 2.4 / 3.x (корп. и проф.)
// Формат вывода: папки + файлы + <имяфайла>.meta.json рядом с каждой версией
// ===========================================================================
//
// СТРУКТУРА КАТАЛОГА ВЫГРУЗКИ:
//   <КаталогВыгрузки>/
//     _export_index.json          -- сводный индекс всех документов
//     <ПапкаДО>/
//       <ПапкаДО2>/
//         ИмяФайла.docx           -- текущая (последняя) версия
//         ИмяФайла.docx.meta.json -- метаданные текущей версии
//         _versions/
//           ИмяФайла.v001.docx           -- версия 1
//           ИмяФайла.v001.docx.meta.json -- метаданные версии 1
//           ИмяФайла.v002.docx
//           ИмяФайла.v002.docx.meta.json
// ===========================================================================

#Область ОпределениеПеременных

Перем КаталогВыгрузки;         // Корневой каталог для выгрузки
Перем ВыгружатьВерсии;         // Булево: выгружать все версии или только текущую
Перем ВыгружатьУдалённые;      // Булево: включать помеченные на удаление
Перем МаксВерсийНаФайл;        // 0 = все версии, N = последние N версий
Перем ТекущийЖурнал;           // Строка лога
Перем КоличествоОшибок;
Перем КоличествоВыгружено;
Перем КоличествоВерсий;

#КонецОбласти

// ---------------------------------------------------------------------------
// ТОЧКА ВХОДА
// ---------------------------------------------------------------------------
Процедура ВыполнитьВыгрузку() Экспорт

    КоличествоОшибок  = 0;
    КоличествоВыгружено = 0;
    КоличествоВерсий  = 0;
    ТекущийЖурнал     = "";

    Если НЕ ПроверитьПараметры() Тогда
        Возврат;
    КонецЕсли;

    ЗаписатьЛог("=== Начало выгрузки: " + Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy ЧЧ:мм:сс") + " ===");
    ЗаписатьЛог("Каталог выгрузки: " + КаталогВыгрузки);
    ЗаписатьЛог("Выгружать версии: " + ?(ВыгружатьВерсии, "Да", "Нет"));

    ИндексФайлов = Новый Массив;

    // -----------------------------------------------------------------------
    // Получаем все файлы 1С:ДО
    // -----------------------------------------------------------------------
    ЗаписатьЛог("Получение списка файлов...");

    // Поддержка нескольких возможных имён справочника в разных версиях конфигурации
    ИмяСправочникаФайлов = ОпределитьИмяСправочникаФайлов();
    Если ИмяСправочникаФайлов = "" Тогда
        ЗаписатьЛог("[ОШИБКА] Не найден справочник файлов. Проверьте совместимость обработки с версией 1С:ДО.");
        Возврат;
    КонецЕсли;

    ЗаписатьЛог("Используется справочник: " + ИмяСправочникаФайлов);

    Запрос = Новый Запрос;
    Запрос.Текст = СформироватьЗапросФайлов(ИмяСправочникаФайлов);
    РезультатЗапроса = Запрос.Выполнить();
    Выборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

    Пока Выборка.Следующий() Цикл
        ВыгрузитьФайлСВерсиями(Выборка, ИндексФайлов);
    КонецЦикла;

    // -----------------------------------------------------------------------
    // Сохраняем сводный индекс
    // -----------------------------------------------------------------------
    СохранитьИндекс(ИндексФайлов);

    ЗаписатьЛог("=== Выгрузка завершена ===");
    ЗаписатьЛог("Файлов выгружено:  " + КоличествоВыгружено);
    ЗаписатьЛог("Версий выгружено:  " + КоличествоВерсий);
    ЗаписатьЛог("Ошибок:            " + КоличествоОшибок);

    СохранитьЛог();

КонецПроцедуры

// ---------------------------------------------------------------------------
// Определяем имя справочника файлов (зависит от версии конфигурации)
// ---------------------------------------------------------------------------
Функция ОпределитьИмяСправочникаФайлов()

    КандидатыСправочников = Новый Массив;
    КандидатыСправочников.Добавить("ФайлыДокументов");      // 1С:ДО 2.x
    КандидатыСправочников.Добавить("Файлы");                // 1С:ДО 3.x / БСП
    КандидатыСправочников.Добавить("ДополнительныеФайлы");  // нестандартные конфигурации

    Для Каждого Имя Из КандидатыСправочников Цикл
        Попытка
            МД = Метаданные.Справочники.Найти(Имя);
            Если МД <> Неопределено Тогда
                Возврат Имя;
            КонецЕсли;
        Исключение
            // продолжаем перебор
        КонецПопытки;
    КонецЦикла;

    Возврат "";

КонецФункции

// ---------------------------------------------------------------------------
// Формируем запрос для получения файлов из справочника
// ---------------------------------------------------------------------------
Функция СформироватьЗапросФайлов(ИмяСправочника)

    УсловиеУдалённых = ?(ВыгружатьУдалённые, "", "И НЕ ф.ПометкаУдаления");

    Возврат "ВЫБРАТЬ
    |    ф.Ссылка                  КАК Ссылка,
    |    ф.Наименование            КАК Наименование,
    |    ф.Расширение              КАК Расширение,
    |    ф.Описание                КАК Описание,
    |    ф.Автор                   КАК Автор,
    |    ф.ДатаСоздания            КАК ДатаСоздания,
    |    ф.ДатаМодификации         КАК ДатаМодификации,
    |    ф.РазмерХранимогоФайла    КАК Размер,
    |    ф.ПометкаУдаления         КАК ПометкаУдаления,
    |    ф.Родитель                КАК Родитель,
    |    ф.ВерсияФайла             КАК ТекущаяВерсия
    |ИЗ
    |    Справочник." + ИмяСправочника + " КАК ф
    |ГДЕ
    |    ф.ЭтоГруппа = ЛОЖЬ
    |    " + УсловиеУдалённых + "
    |УПОРЯДОЧИТЬ ПО
    |    ф.Родитель,
    |    ф.Наименование
    |ИТОГИ ПО
    |    ф.Родитель";

КонецФункции

// ---------------------------------------------------------------------------
// Выгружаем один файл со всеми его версиями
// ---------------------------------------------------------------------------
Процедура ВыгрузитьФайлСВерсиями(СтрокаФайла, ИндексФайлов)

    СсылкаНаФайл = СтрокаФайла.Ссылка;

    // Определяем относительный путь папки внутри структуры 1С:ДО
    ОтносительныйПуть = ПолучитьОтносительныйПутьПапки(СтрокаФайла.Родитель);
    АбсолютнаяПапка   = КаталогВыгрузки + ОтносительныйПуть;

    СоздатьПапкуЕслиНет(АбсолютнаяПапка);

    БезопасноеИмя = ОчиститьИмяФайла(СтрокаФайла.Наименование);
    Расширение    = НРег(СтрокаФайла.Расширение);
    Если Расширение <> "" И Лев(Расширение, 1) <> "." Тогда
        Расширение = "." + Расширение;
    КонецЕсли;
    БазовоеИмяФайла = БезопасноеИмя + Расширение;

    // -------------------------------------------------------------------
    // Получаем версии файла
    // -------------------------------------------------------------------
    СписокВерсий = ПолучитьВерсииФайла(СсылкаНаФайл);

    Если ВыгружатьВерсии И СписокВерсий.Количество() > 1 Тогда
        ПапкаВерсий = АбсолютнаяПапка + "_versions" + ПолучитьРазделительПути();
        СоздатьПапкуЕслиНет(ПапкаВерсий);

        Для НомерЗаписи = 0 По СписокВерсий.Количество() - 1 Цикл
            Версия      = СписокВерсий[НомерЗаписи];
            НомерВерсии = Формат(НомерЗаписи + 1, "ЧЦ=3; ЧВН=; ЧГ=0");
            ИмяВерсии   = БезопасноеИмя + ".v" + НомерВерсии + Расширение;

            ВыгрузитьОдинФайл(
                Версия,
                ПапкаВерсий + ИмяВерсии,
                СтрокаФайла,
                НомерЗаписи + 1,
                СписокВерсий.Количество()
            );
        КонецЦикла;
    КонецЕсли;

    // -------------------------------------------------------------------
    // Выгружаем текущую (последнюю) версию как основной файл
    // -------------------------------------------------------------------
    Если СписокВерсий.Количество() > 0 Тогда
        ПоследняяВерсия = СписокВерсий[СписокВерсий.Количество() - 1];
        ВыгрузитьОдинФайл(
            ПоследняяВерсия,
            АбсолютнаяПапка + БазовоеИмяФайла,
            СтрокаФайла,
            СписокВерсий.Количество(),
            СписокВерсий.Количество(),
            Истина  // флаг "это текущая версия"
        );
        КоличествоВыгружено = КоличествоВыгружено + 1;
    КонецЕсли;

    // -------------------------------------------------------------------
    // Добавляем запись в сводный индекс
    // -------------------------------------------------------------------
    ЗаписьИндекса = Новый Структура;
    ЗаписьИндекса.Вставить("guid",            Строка(СсылкаНаФайл.УникальныйИдентификатор()));
    ЗаписьИндекса.Вставить("name",            СтрокаФайла.Наименование);
    ЗаписьИндекса.Вставить("extension",       Расширение);
    ЗаписьИндекса.Вставить("relative_path",   ОтносительныйПуть + БазовоеИмяФайла);
    ЗаписьИндекса.Вставить("versions_count",  СписокВерсий.Количество());
    ЗаписьИндекса.Вставить("author",          Строка(СтрокаФайла.Автор));
    ЗаписьИндекса.Вставить("created",         Формат(СтрокаФайла.ДатаСоздания, "ДФ=yyyy-MM-ddTHH:mm:ss"));
    ЗаписьИндекса.Вставить("modified",        Формат(СтрокаФайла.ДатаМодификации, "ДФ=yyyy-MM-ddTHH:mm:ss"));
    ЗаписьИндекса.Вставить("deleted",         СтрокаФайла.ПометкаУдаления);
    ИндексФайлов.Добавить(ЗаписьИндекса);

КонецПроцедуры

// ---------------------------------------------------------------------------
// Выгружаем двоичные данные одной версии файла + JSON с метаданными
// ---------------------------------------------------------------------------
Процедура ВыгрузитьОдинФайл(Версия, ПолныйПутьФайла, МетаФайла, НомерВерсии, ВсегоВерсий, ЭтоТекущая = Ложь)

    Попытка
        // Извлекаем двоичные данные
        ДвоичныеДанные = Неопределено;

        // Попытка 1: данные хранятся напрямую в ХранилищеФайла
        Если ТипЗнч(Версия) = Тип("Структура") Тогда
            Если Версия.Свойство("ХранилищеФайла") Тогда
                ДвоичныеДанные = Версия.ХранилищеФайла.Получить();
            КонецЕсли;
        КонецЕсли;

        // Попытка 2: получить через объект регистра версий
        Если ДвоичныеДанные = Неопределено Тогда
            ДвоичныеДанные = ПолучитьДвоичныеДанныеВерсии(Версия);
        КонецЕсли;

        Если ДвоичныеДанные = Неопределено Тогда
            ЗаписатьЛог("[ПРЕДУПРЕЖДЕНИЕ] Нет данных для: " + ПолныйПутьФайла);
            КоличествоОшибок = КоличествоОшибок + 1;
            Возврат;
        КонецЕсли;

        ДвоичныеДанные.Записать(ПолныйПутьФайла);

        // -------------------------------------------------------------------
        // Формируем и сохраняем JSON с метаданными рядом с файлом
        // -------------------------------------------------------------------
        МетаданныеJSON = СформироватьМетаданныеJSON(МетаФайла, Версия, НомерВерсии, ВсегоВерсий, ЭтоТекущая);
        ЗаписатьJSON(ПолныйПутьФайла + ".meta.json", МетаданныеJSON);

        КоличествоВерсий = КоличествоВерсий + 1;

    Исключение
        ЗаписатьЛог("[ОШИБКА] " + ПолныйПутьФайла + ": " + ОписаниеОшибки());
        КоличествоОшибок = КоличествоОшибок + 1;
    КонецПопытки;

КонецПроцедуры

// ---------------------------------------------------------------------------
// Получаем двоичные данные версии из регистра сведений
// ---------------------------------------------------------------------------
Функция ПолучитьДвоичныеДанныеВерсии(Версия)

    ДвоичныеДанные = Неопределено;

    Попытка
        // Тип 1: Версия — строка выборки регистра с ХранилищеФайла
        Если ТипЗнч(Версия) = Тип("Структура") Тогда
            Если Версия.Свойство("ДвоичныеДанные") Тогда
                Возврат Версия.ДвоичныеДанные;
            КонецЕсли;
        КонецЕсли;

        // Тип 2: Версия — ссылка на запись регистра версий
        ИменаРегистровВерсий = Новый Массив;
        ИменаРегистровВерсий.Добавить("ВерсииФайлов");
        ИменаРегистровВерсий.Добавить("ВерсииФайловДокументов");
        ИменаРегистровВерсий.Добавить("ФайлыВерсии");

        Для Каждого ИмяРег Из ИменаРегистровВерсий Цикл
            Попытка
                МД = Метаданные.РегистрыСведений.Найти(ИмяРег);
                Если МД = Неопределено Тогда
                    Продолжить;
                КонецЕсли;

                МенеджерРегистра = РегистрыСведений[ИмяРег];
                ОтборЗаписи      = Новый Структура("Файл", Версия);

                // Пробуем получить запись напрямую
                ЗаписьРегистра = МенеджерРегистра.СоздатьМенеджерЗаписи();
                ЗаписьРегистра.Файл = Версия;
                ЗаписьРегистра.Прочитать();

                Если ЗаписьРегистра.ХранилищеФайла <> Неопределено Тогда
                    ДвоичныеДанные = ЗаписьРегистра.ХранилищеФайла.Получить();
                    Если ДвоичныеДанные <> Неопределено Тогда
                        Возврат ДвоичныеДанные;
                    КонецЕсли;
                КонецЕсли;
            Исключение
                // Регистр не подошёл, пробуем следующий
            КонецПопытки;
        КонецЦикла;
    Исключение
        // Возвращаем Неопределено ниже
    КонецПопытки;

    Возврат ДвоичныеДанные;

КонецФункции

// ---------------------------------------------------------------------------
// Получаем все версии файла из регистра сведений ВерсииФайлов
// ---------------------------------------------------------------------------
Функция ПолучитьВерсииФайла(СсылкаНаФайл)

    СписокВерсий = Новый Массив;

    ИменаРегистров = Новый Массив;
    ИменаРегистров.Добавить("ВерсииФайлов");
    ИменаРегистров.Добавить("ВерсииФайловДокументов");

    Для Каждого ИмяРег Из ИменаРегистров Цикл
        МД = Метаданные.РегистрыСведений.Найти(ИмяРег);
        Если МД = Неопределено Тогда
            Продолжить;
        КонецЕсли;

        Попытка
            Запрос = Новый Запрос;
            Запрос.Текст =
                "ВЫБРАТЬ
                |    рег.НомерВерсии         КАК НомерВерсии,
                |    рег.ДатаСоздания        КАК ДатаСоздания,
                |    рег.Автор               КАК Автор,
                |    рег.Комментарий         КАК Комментарий,
                |    рег.ХранилищеФайла      КАК ХранилищеФайла,
                |    рег.РазмерХранимогоФайла КАК Размер
                |ИЗ
                |    РегистрСведений." + ИмяРег + " КАК рег
                |ГДЕ
                |    рег.Файл = &Файл
                |УПОРЯДОЧИТЬ ПО
                |    рег.НомерВерсии ВОЗР";

            Запрос.УстановитьПараметр("Файл", СсылкаНаФайл);
            Выборка = Запрос.Выполнить().Выбрать();

            Пока Выборка.Следующий() Цикл
                ЗаписьВерсии = Новый Структура;
                ЗаписьВерсии.Вставить("НомерВерсии",   Выборка.НомерВерсии);
                ЗаписьВерсии.Вставить("ДатаСоздания",  Выборка.ДатаСоздания);
                ЗаписьВерсии.Вставить("Автор",         Строка(Выборка.Автор));
                ЗаписьВерсии.Вставить("Комментарий",   Выборка.Комментарий);
                ЗаписьВерсии.Вставить("ХранилищеФайла", Выборка.ХранилищеФайла);
                ЗаписьВерсии.Вставить("Размер",        Выборка.Размер);
                СписокВерсий.Добавить(ЗаписьВерсии);
            КонецЦикла;

            Если СписокВерсий.Количество() > 0 Тогда
                Прервать; // нашли данные в этом регистре
            КонецЕсли;
        Исключение
            ЗаписатьЛог("[ПРЕДУПРЕЖДЕНИЕ] Регистр " + ИмяРег + ": " + ОписаниеОшибки());
        КонецПопытки;
    КонецЦикла;

    // Если версий нет в регистре — делаем одну «версию» из самого файла
    Если СписокВерсий.Количество() = 0 Тогда
        Попытка
            ОбъектФайла = СсылкаНаФайл.ПолучитьОбъект();
            Если ОбъектФайла <> Неопределено Тогда
                ЗаписьВерсии = Новый Структура;
                ЗаписьВерсии.Вставить("НомерВерсии",   1);
                ЗаписьВерсии.Вставить("ДатаСоздания",  ОбъектФайла.ДатаСоздания);
                ЗаписьВерсии.Вставить("Автор",         Строка(ОбъектФайла.Автор));
                ЗаписьВерсии.Вставить("Комментарий",   "");
                ЗаписьВерсии.Вставить("ХранилищеФайла", ОбъектФайла.ХранилищеФайла);
                ЗаписьВерсии.Вставить("Размер",        ОбъектФайла.РазмерХранимогоФайла);
                СписокВерсий.Добавить(ЗаписьВерсии);
            КонецЕсли;
        Исключение
            // ничего не делаем
        КонецПопытки;
    КонецЕсли;

    Возврат СписокВерсий;

КонецФункции

// ---------------------------------------------------------------------------
// Формируем структуру метаданных для JSON
// ---------------------------------------------------------------------------
Функция СформироватьМетаданныеJSON(МетаФайла, Версия, НомерВерсии, ВсегоВерсий, ЭтоТекущая)

    Мета = Новый Структура;

    // Основные поля файла
    Мета.Вставить("source_system",   "1C:DO");
    Мета.Вставить("name",            МетаФайла.Наименование);
    Мета.Вставить("extension",       МетаФайла.Расширение);
    Мета.Вставить("description",     МетаФайла.Описание);
    Мета.Вставить("author",          Строка(МетаФайла.Автор));
    Мета.Вставить("created_at",      Формат(МетаФайла.ДатаСоздания,    "ДФ=yyyy-MM-ddTHH:mm:ss"));
    Мета.Вставить("modified_at",     Формат(МетаФайла.ДатаМодификации, "ДФ=yyyy-MM-ddTHH:mm:ss"));
    Мета.Вставить("folder",          Строка(МетаФайла.Родитель));
    Мета.Вставить("guid_1c",         Строка(МетаФайла.Ссылка.УникальныйИдентификатор()));
    Мета.Вставить("is_deleted",      МетаФайла.ПометкаУдаления);

    // Поля версии
    ВерсияСтр = Новый Структура;
    ВерсияСтр.Вставить("number",       НомерВерсии);
    ВерсияСтр.Вставить("total",        ВсегоВерсий);
    ВерсияСтр.Вставить("is_current",   ЭтоТекущая);
    ВерсияСтр.Вставить("size_bytes",   ?(ТипЗнч(Версия) = Тип("Структура") И Версия.Свойство("Размер"), Версия.Размер, 0));
    ВерсияСтр.Вставить("comment",      ?(ТипЗнч(Версия) = Тип("Структура") И Версия.Свойство("Комментарий"), Версия.Комментарий, ""));
    ВерсияСтр.Вставить("version_author", ?(ТипЗнч(Версия) = Тип("Структура") И Версия.Свойство("Автор"), Версия.Автор, Строка(МетаФайла.Автор)));
    ВерсияСтр.Вставить("version_date",   ?(ТипЗнч(Версия) = Тип("Структура") И Версия.Свойство("ДатаСоздания"),
        Формат(Версия.ДатаСоздания, "ДФ=yyyy-MM-ddTHH:mm:ss"), ""));
    Мета.Вставить("version", ВерсияСтр);

    Возврат Мета;

КонецФункции

// ---------------------------------------------------------------------------
// Получаем относительный путь для папки 1С:ДО (рекурсивно по иерархии)
// ---------------------------------------------------------------------------
Функция ПолучитьОтносительныйПутьПапки(СсылкаНаПапку)

    Если СсылкаНаПапку.Пустая() Тогда
        Возврат "";
    КонецЕсли;

    Разделитель = ПолучитьРазделительПути();
    ЧасtiПути   = Новый Массив;
    ТекПапка    = СсылкаНаПапку;
    Глубина     = 0;

    Пока НЕ ТекПапка.Пустая() И Глубина < 30 Цикл
        ИмяПапки = ОчиститьИмяФайла(Строка(ТекПапка));
        ЧасtiПути.Вставить(0, ИмяПапки);
        Попытка
            ТекПапка = ТекПапка.Родитель;
        Исключение
            Прервать;
        КонецПопытки;
        Глубина = Глубина + 1;
    КонецЦикла;

    Если ЧасtiПути.Количество() = 0 Тогда
        Возврат "";
    КонецЕсли;

    Возврат СтрСоединить(ЧасtiПути, Разделитель) + Разделитель;

КонецФункции

// ---------------------------------------------------------------------------
// Сохраняем сводный индекс всей выгрузки
// ---------------------------------------------------------------------------
Процедура СохранитьИндекс(ИндексФайлов)

    ИндексОбъект = Новый Структура;
    ИндексОбъект.Вставить("export_date",    Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
    ИндексОбъект.Вставить("source_system",  "1C:DO");
    ИндексОбъект.Вставить("total_files",    КоличествоВыгружено);
    ИндексОбъект.Вставить("total_versions", КоличествоВерсий);
    ИндексОбъект.Вставить("errors",         КоличествоОшибок);
    ИндексОбъект.Вставить("files",          ИндексФайлов);

    ЗаписатьJSON(КаталогВыгрузки + "_export_index.json", ИндексОбъект);

КонецПроцедуры

// ---------------------------------------------------------------------------
// Вспомогательные функции
// ---------------------------------------------------------------------------

Процедура СоздатьПапкуЕслиНет(Путь)
    Если НЕ КаталогСуществует(Путь) Тогда
        СоздатьКаталог(Путь);
    КонецЕсли;
КонецПроцедуры

Функция ОчиститьИмяФайла(Имя)
    НедопустимыеСимволы = Новый Массив;
    НедопустимыеСимволы.Добавить("\");
    НедопустимыеСимволы.Добавить("/");
    НедопустимыеСимволы.Добавить(":");
    НедопустимыеСимволы.Добавить("*");
    НедопустимыеСимволы.Добавить("?");
    НедопустимыеСимволы.Добавить("""");
    НедопустимыеСимволы.Добавить("<");
    НедопустимыеСимволы.Добавить(">");
    НедопустимыеСимволы.Добавить("|");

    Результат = Имя;
    Для Каждого Символ Из НедопустимыеСимволы Цикл
        Результат = СтрЗаменить(Результат, Символ, "_");
    КонецЦикла;
    Результат = СокрЛП(Результат);
    Если СтрДлина(Результат) > 200 Тогда
        Результат = Лев(Результат, 200);
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ПолучитьРазделительПути()
    Если Найти(СистемнаяИнформация().Платформа, "Windows") > 0
        ИЛИ Найти(НРег(СистемнаяИнформация().Платформа), "win") > 0 Тогда
        Возврат "\";
    Иначе
        Возврат "/";
    КонецЕсли;
КонецФункции

Процедура ЗаписатьJSON(ПутьКФайлу, Данные)
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.ОткрытьФайл(ПутьКФайлу, "UTF-8");
    ЗаписьJSON.Отступ = Истина;  // pretty-print
    ЗаписатьJSON(ЗаписьJSON, Данные);
    ЗаписьJSON.Закрыть();
КонецПроцедуры

Процедура ЗаписатьЛог(Сообщение)
    ТекущийЖурнал = ТекущийЖурнал + Сообщение + Символы.ПС;
    Сообщить(Сообщение);
КонецПроцедуры

Процедура СохранитьЛог()
    ПутьЛога = КаталогВыгрузки + "_export_log_"
        + Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmmss") + ".txt";
    ЗаписьТекста = Новый ЗаписьТекста(ПутьЛога, КодировкаТекста.UTF8);
    ЗаписьТекста.Записать(ТекущийЖурнал);
    ЗаписьТекста.Закрыть();
КонецПроцедуры

Функция ПроверитьПараметры()
    Если ПустаяСтрока(КаталогВыгрузки) Тогда
        Сообщить("[ОШИБКА] Не задан каталог выгрузки.");
        Возврат Ложь;
    КонецЕсли;
    КаталогВыгрузки = СокрЛП(КаталогВыгрузки);
    Разделитель = ПолучитьРазделительПути();
    Если Прав(КаталогВыгрузки, 1) <> Разделитель Тогда
        КаталогВыгрузки = КаталогВыгрузки + Разделитель;
    КонецЕсли;
    СоздатьПапкуЕслиНет(КаталогВыгрузки);
    Возврат Истина;
КонецФункции

